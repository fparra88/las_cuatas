# Copia a .env y ajusta. NO subir .env al repo.
#
# PRODUCCION (EasyPanel Postgres): usa la cadena INTERNA del servicio.
# Host = nombre del servicio Postgres en el proyecto EasyPanel (red interna).
# DATABASE_URL=postgresql://usuario:password@nombre-servicio-postgres:5432/nombre_db
#
# LOCAL (dev): SQLite por defecto si no defines DATABASE_URL.
DATABASE_URL=sqlite:///./las_cuatas.db
